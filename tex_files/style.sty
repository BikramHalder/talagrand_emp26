%% ── Theorem styles ────────────────────────────────────────────────
%% Using pure amsthm (thmtools numberlike/sibling is broken with LaTeX 2026 kernel)
\newtheoremstyle{thmsty}%        Theorem / Proposition / Lemma
  {}{}{\itshape}{}%              body italic
  {\sffamily\color{darkblue}}%   head: sans-serif, dark blue
  {.}{ }{}

\newtheoremstyle{defsty}%        Definition
  {}{}{}{}%                      body upright
  {\sffamily\color{cerulean}}%   head: sans-serif, cerulean
  {.}{ }{}

\newtheoremstyle{rmksty}%        Remark
  {}{}{}{}%                      body upright
  {\sffamily\color{brightmaroon}}% head: sans-serif, bright maroon
  {.}{ }{}

\newtheoremstyle{egsty}%         Example
  {}{}{}{}%                      body upright
  {\sffamily\color{bluegray}}%   head: sans-serif, blue-gray
  {.}{ }{}

\theoremstyle{thmsty}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{lemma}[theorem]{Lemma}

\theoremstyle{defsty}
\newtheorem{definition}[theorem]{Definition}

\theoremstyle{rmksty}
\newtheorem{remark}[theorem]{Remark}

\theoremstyle{egsty}
\newtheorem{example}[theorem]{Example}